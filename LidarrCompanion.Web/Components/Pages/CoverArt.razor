@page "/cover-art"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using LidarrCompanion.Helpers
@using LidarrCompanion.Models
@inject CoverArtGateService Gate
@inject TriageService Triage
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Cover Art - LidarrCompanion</PageTitle>

@if (!Gate.HasPending)
{
    <div class="cover-art-empty">
        <p>No files are currently waiting for cover art.</p>
    </div>
}
else
{
    <div class="cover-art-page">
        <div class="cover-art-list">
            <h2>Files (@Gate.PendingItems.Count(i => i.HasCoverArt)/@Gate.PendingItems.Count have art)</h2>
            <table class="triage-table">
                <thead><tr><th></th><th>File</th><th>Destination</th></tr></thead>
                <tbody>
                    @* Display-only ordering (files still missing art first, then alphabetical) -
                       Gate.PendingItems itself stays in its original order since SkipToNext and
                       SelectFirstMissingOrFirst below index into it directly. *@
                    @foreach (var item in Gate.PendingItems.OrderBy(i => i.HasCoverArt).ThenBy(i => i.FileName, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr class="@(item == _current ? "row-selected" : "")" @onclick="() => SelectItem(item)">
                            <td>@(item.HasCoverArt ? "✓" : "")</td>
                            <td>@item.FileName</td>
                            <td>@item.DestinationName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="cover-art-detail">
            @if (_current is not null)
            {
                <div class="cover-art-info">
                    <div><strong>Artist:</strong> @(_current.Artist ?? "-")</div>
                    <div><strong>Album:</strong> @(_current.Album ?? "-")</div>
                    <div><strong>File:</strong> @_current.FileName</div>
                </div>

                <div class="cover-art-search">
                    <input @bind="_searchTerm" @bind:event="oninput" placeholder="Search..." />
                    <button @onclick="SearchDiscogs" disabled="@_isBusy">Search Discogs</button>
                    <button @onclick="SearchManual" disabled="@_isBusy">Search Web Images</button>
                    <button @onclick="BrowseByArtist" disabled="@_isBusy">Browse Artist on Discogs</button>
                    <label class="cover-art-autosearch">
                        <input type="checkbox" @bind="_autoSearchEnabled" @bind:after="OnAutoSearchChanged" /> Auto-search
                    </label>
                </div>

                @* Results scroll in their own fixed-height frame, with the cover art box and the
                   selected-result preview always visible below - so paging through a long result
                   list never pushes the Save/Reset/Skip/Complete buttons off screen. *@
                <div class="cover-art-results-frame">
                    @if (_manualResults.Count > 0)
                    {
                        <div class="cover-art-results">
                            @foreach (var r in _manualResults)
                            {
                                <div class="cover-art-browse-item" @onclick="() => LoadPreview(r)">
                                    <img src="@r.ThumbnailUrl" title="@r.Title" alt="@r.Title" class="cover-art-result-thumb" />
                                    <span class="cover-art-browse-title">@(r.Width is { } w && r.Height is { } h ? $"{w} × {h}" : string.Empty)</span>
                                </div>
                            }
                        </div>
                    }

                    @if (_discogsResults.Count > 0)
                    {
                        <div class="cover-art-results">
                            @foreach (var release in _discogsResults)
                            {
                                <div class="cover-art-browse-item" @onclick="() => LoadPreview(release)">
                                    <img src="@(release.ThumbUrl ?? release.CoverImageUrl)"
                                         title="@release.Title" alt="@release.Title" class="cover-art-result-thumb"
                                         onerror="this.style.visibility='hidden'" />
                                    <span class="cover-art-browse-title">@release.Title@(release.Year is { Length: > 0 } y ? $" ({y})" : "")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="cover-art-preview-row">
                    <div class="cover-art-preview" @ondragover="@(() => {})" @ondragover:preventDefault="true" @ondrop="CommitPreview" @ondrop:preventDefault="true">
                        @if (StagedImageDataUri is not null)
                        {
                            <img src="@StagedImageDataUri" alt="cover art preview" />
                        }
                        else if (ExistingImageDataUri is not null)
                        {
                            <img src="@ExistingImageDataUri" alt="existing cover art" />
                        }
                        else
                        {
                            <div class="cover-art-drop-hint">No cover art yet. Search above, then drag a result here (or paste one with Ctrl+V).</div>
                        }
                    </div>

                    @if (_previewSrc is not null)
                    {
                        <div class="cover-art-preview-side">
                            <img src="@_previewSrc" draggable="true" id="cover-art-preview-img"
                                 ondragstart="event.dataTransfer.setData('text/plain', 'cover-art-candidate')"
                                 onload="document.getElementById('cover-art-preview-dims').textContent = this.naturalWidth + ' × ' + this.naturalHeight + ' px'"
                                 onerror="document.getElementById('cover-art-preview-dims').textContent = 'Image failed to load'" />
                            <div id="cover-art-preview-dims" class="cover-art-preview-dims"></div>
                            @if (!string.IsNullOrWhiteSpace(_previewDescription))
                            {
                                <p class="cover-art-preview-description">@_previewDescription</p>
                            }
                            @if (_previewSourceUrl is not null)
                            {
                                <a href="@_previewSourceUrl" target="_blank" rel="noopener noreferrer" class="cover-art-preview-link">@_previewSourceLabel</a>
                            }
                            <p class="cover-art-preview-hint">Drag onto the box on the left to use it</p>
                            <div class="cover-art-preview-side-actions">
                                <button @onclick="CommitPreview" disabled="@_isBusy">Use this image</button>
                                <button @onclick="ClearPreview">Dismiss</button>
                            </div>
                        </div>
                    }
                </div>

                <p class="cover-art-status">@_statusMessage</p>

                <div class="cover-art-actions">
                    <button @onclick="SaveAndNext" disabled="@(_stagedImage is null || _isBusy)">@(_isLastMissing ? "Save & Finish" : "Save & Next")</button>
                    <button @onclick="ResetImage" disabled="@(_stagedImage is null || _isBusy)">Reset</button>
                    <button @onclick="SkipToNext" disabled="@_isBusy">Skip</button>
                    <button @onclick="Complete" disabled="@_isBusy">Complete</button>
                    <button @onclick="AbortImport" disabled="@_isBusy" class="cover-art-abort">Abort Import</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private CoverArtQueueItem? _current;
    private string _searchTerm = string.Empty;
    private string _statusMessage = string.Empty;
    private bool _isBusy;
    // Persisted (Settings > CoverArt) rather than session-only, so the preference sticks across
    // visits instead of resetting to off every time this page loads.
    private bool _autoSearchEnabled = AppSettings.Current.GetTyped<bool>(SettingKey.AutoSearchCoverArt);
    private byte[]? _stagedImage;
    private string? _stagedMimeType;
    private List<SerpApiImageResult> _manualResults = new();
    private List<DiscogsRelease> _discogsResults = new();

    // Side preview: a shared "load it, then drag it onto the target" step for both result grids,
    // replacing both the old click-straight-to-stage behavior and an earlier modal-dialog design -
    // the user specifically didn't want a click -> open window -> wait -> click routine. Exactly
    // one of the two source fields is set at a time, depending on which grid the click came from;
    // CommitPreview uses whichever is set to know how to actually fetch the full image, whether
    // triggered by dropping the preview onto the target box or by the fallback button.
    private string? _previewSrc;
    private SerpApiImageResult? _previewSerpResult;
    private DiscogsRelease? _previewDiscogsRelease;
    private string? _previewDescription;
    private string? _previewSourceUrl;
    private string? _previewSourceLabel;

    private IJSObjectReference? _pasteModule;
    private DotNetObjectReference<CoverArt>? _selfRef;

    private bool _isLastMissing => Gate.PendingItems.Count(i => !i.HasCoverArt) <= 1;

    private string? ExistingImageDataUri => _current?.CoverArtPreview is { } bytes
        ? $"data:{_current.CoverArtMimeType ?? "image/jpeg"};base64,{Convert.ToBase64String(bytes)}"
        : null;

    private string? StagedImageDataUri => _stagedImage is { } bytes
        ? $"data:{_stagedMimeType ?? "image/jpeg"};base64,{Convert.ToBase64String(bytes)}"
        : null;

    protected override void OnInitialized()
    {
        Gate.Changed += OnGateChanged;
        if (Gate.HasPending)
            SelectFirstMissingOrFirst();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _pasteModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/coverArtPaste.js");
            await _pasteModule.InvokeVoidAsync("registerPaste", _selfRef);
        }
    }

    private void OnGateChanged() => InvokeAsync(StateHasChanged);

    private void SelectFirstMissingOrFirst()
    {
        _current = Gate.PendingItems.FirstOrDefault(i => !i.HasCoverArt) ?? Gate.PendingItems.FirstOrDefault();
        if (_current is not null)
            LoadItem(_current);
    }

    private void SelectItem(CoverArtQueueItem item)
    {
        _current = item;
        LoadItem(item);
    }

    // Deliberately does NOT auto-run a search on load any more - it used to (against MusicBrainz),
    // and would silently auto-stage the first result it found, which on a loosened (more
    // forgiving) query is more likely to be a plausible-but-wrong match than a bad one. Landing on
    // an item now just shows what's already there; searching is an explicit action the user takes.
    private void LoadItem(CoverArtQueueItem item)
    {
        _stagedImage = null;
        _stagedMimeType = null;
        _manualResults.Clear();
        _discogsResults.Clear();
        ClearPreview();
        _statusMessage = string.Empty;
        _searchTerm = BuildSearchQuery(item);

        if (_autoSearchEnabled) _ = SearchManual();
    }

    // Artist/album text search (used by the Discogs tiers) is separate and stays structured -
    // this is just the default text for the free-text web-image search box. The filename is
    // usually "Artist - Track" or similar and searches noticeably better in practice than
    // artist+album alone, which is hit-or-miss for anything not tagged with a clean, exact
    // official album title.
    private static string BuildSearchQuery(CoverArtQueueItem item) =>
        Path.GetFileNameWithoutExtension(item.FileName);

    // Tier 1: structured artist+album lookup against Discogs. Populates candidates rather than
    // auto-staging the first one - see the comment on LoadItem above for why.
    private async Task SearchDiscogs()
    {
        if (_current is null || _isBusy) return;

        var token = AppSettings.GetValue(SettingKey.DiscogsToken);
        if (string.IsNullOrWhiteSpace(token))
        {
            _statusMessage = "Discogs token is not configured (Settings > CoverArt).";
            return;
        }

        _isBusy = true;
        _statusMessage = "Searching Discogs...";
        _discogsResults.Clear();
        _manualResults.Clear();
        StateHasChanged();

        try
        {
            var discogs = new DiscogsHelper();
            _discogsResults = await discogs.SearchAsync(token, _current.Artist, _current.Album ?? _current.ReleaseName);
            _statusMessage = _discogsResults.Count == 0
                ? "No match found - try Browse Artist, Search Web Images, or paste an image."
                : $"{_discogsResults.Count} result(s) - click one to preview.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Discogs search failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Tier 2: manual-only SerpApi fallback, for files with no automatic match.
    private async Task SearchManual()
    {
        if (_isBusy || string.IsNullOrWhiteSpace(_searchTerm)) return;
        _isBusy = true;
        _statusMessage = $"Searching web images for: {_searchTerm}";
        _manualResults.Clear();
        _discogsResults.Clear();
        StateHasChanged();

        try
        {
            var apiKey = AppSettings.GetValue(SettingKey.SerpApiKey);
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                _statusMessage = "SerpApi key is not configured (Settings > CoverArt).";
                return;
            }

            var serp = new SerpApiHelper();
            _manualResults = await serp.SearchImagesAsync(apiKey, _searchTerm);
            _statusMessage = _manualResults.Count == 0 ? "No web image results found." : string.Empty;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Web image search failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Tier 3: manual "show everything by this artist" browse, for when even a structured
    // artist+album search finds nothing - lets the user pick the right release visually instead
    // of the automatic tier just giving up silently.
    private async Task BrowseByArtist()
    {
        if (_current is null || _isBusy) return;
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _statusMessage = "Enter an artist name in the search box to browse by.";
            return;
        }

        var token = AppSettings.GetValue(SettingKey.DiscogsToken);
        if (string.IsNullOrWhiteSpace(token))
        {
            _statusMessage = "Discogs token is not configured (Settings > CoverArt).";
            return;
        }

        // Uses whatever is actually in the search box, not the file's raw artist tag - so
        // correcting a mistagged/misspelled artist there before clicking actually takes effect.
        _isBusy = true;
        _statusMessage = $"Browsing Discogs for '{_searchTerm}'...";
        _discogsResults.Clear();
        _manualResults.Clear();
        StateHasChanged();

        try
        {
            var discogs = new DiscogsHelper();
            _discogsResults = await discogs.BrowseByArtistAsync(token, _searchTerm);
            _statusMessage = _discogsResults.Count == 0
                ? "No releases found for this artist."
                : $"{_discogsResults.Count} release(s) found - click one to preview.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Browse failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Preview only - no network call yet. SerpApi's and Discogs' own image URLs are both directly
    // usable as an <img src>, so loading the preview is instant; the actual download only happens
    // on commit (drag onto the target box, or the fallback button).
    private void LoadPreview(SerpApiImageResult result)
    {
        _previewSrc = result.FullUrl;
        _previewSerpResult = result;
        _previewDiscogsRelease = null;
        _previewDescription = result.Title;
        _previewSourceUrl = result.SourceUrl;
        _previewSourceLabel = string.IsNullOrWhiteSpace(result.SourceName) ? "View source" : $"View on {result.SourceName}";
    }

    private void LoadPreview(DiscogsRelease release)
    {
        _previewSrc = release.CoverImageUrl ?? release.ThumbUrl;
        _previewDiscogsRelease = release;
        _previewSerpResult = null;
        _previewDescription = release.Description;
        _previewSourceUrl = release.Url;
        _previewSourceLabel = "View on Discogs";
    }

    private void ClearPreview()
    {
        _previewSrc = null;
        _previewSerpResult = null;
        _previewDiscogsRelease = null;
        _previewDescription = null;
        _previewSourceUrl = null;
        _previewSourceLabel = null;
    }

    private async Task CommitPreview()
    {
        if (_isBusy || _previewSrc is null) return;
        _isBusy = true;
        _statusMessage = "Loading selected image...";
        StateHasChanged();

        try
        {
            byte[]? art = _previewSerpResult is { } serpResult
                ? await new SerpApiHelper().DownloadImageAsync(serpResult.FullUrl)
                : _previewDiscogsRelease is { } release && (release.CoverImageUrl ?? release.ThumbUrl) is { } imageUrl
                    ? await new DiscogsHelper().DownloadImageAsync(imageUrl)
                    : null;

            if (art is not null)
            {
                _stagedImage = art;
                _stagedMimeType = "image/jpeg";
                _statusMessage = "Image loaded - click Save & Next to embed it.";
            }
            else
            {
                _statusMessage = "That release has no cover art available - pick another.";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load image: {ex.Message}";
        }
        finally
        {
            ClearPreview();
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void OnImagePasted(string base64, string mimeType)
    {
        try
        {
            _stagedImage = Convert.FromBase64String(base64);
            _stagedMimeType = mimeType;
            _statusMessage = "Image pasted from clipboard.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to paste image: {ex.Message}";
        }
        InvokeAsync(StateHasChanged);
    }

    private void SaveAndNext()
    {
        if (_current is null || _stagedImage is null) return;

        try
        {
            Gate.SaveCoverArt(_current, _stagedImage, _stagedMimeType ?? "image/jpeg");
            SelectFirstMissingOrFirst();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to save cover art: {ex.Message}";
        }
    }

    // Discards the staged (not-yet-saved) image, reverting the preview back to whatever was
    // already embedded in the file - nothing on disk has changed yet at this point, so this is
    // just clearing the in-memory override.
    private void ResetImage()
    {
        _stagedImage = null;
        _stagedMimeType = null;
        _statusMessage = "Reset to original cover art.";
    }

    private void OnAutoSearchChanged()
    {
        AppSettings.Current.Settings[SettingKey.AutoSearchCoverArt.ToString()] = _autoSearchEnabled;
        AppSettings.Save();
    }

    private void SkipToNext()
    {
        if (_current is null) return;
        var currentIndex = Gate.PendingItems.IndexOf(_current);
        var next = Gate.PendingItems.Skip(currentIndex + 1).FirstOrDefault()
            ?? Gate.PendingItems.FirstOrDefault(i => i != _current);
        if (next is not null)
            SelectItem(next);
    }

    private async Task Complete()
    {
        if (_isBusy) return;
        _isBusy = true;
        StateHasChanged();

        // Result is reported via the status bar (see TriageService.PostImportSummary), not here.
        await Triage.ResumeImportAfterCoverArtAsync();
        Nav.NavigateTo("/import");
    }

    private async Task AbortImport()
    {
        if (_isBusy) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to abort the import process? Files already moved will not be reverted.");
        if (!confirmed) return;

        Triage.AbortImportAfterCoverArt();
        Nav.NavigateTo("/import");
    }

    public async ValueTask DisposeAsync()
    {
        Gate.Changed -= OnGateChanged;

        if (_pasteModule is not null)
        {
            try { await _pasteModule.InvokeVoidAsync("unregisterPaste"); } catch { /* circuit may already be gone */ }
            try { await _pasteModule.DisposeAsync(); } catch { /* circuit may already be gone */ }
        }

        _selfRef?.Dispose();
    }
}
