@page "/import"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject TriageService Triage
@inject StatusService Status
@inject IPlaybackService Playback
@inject CoverArtGateService CoverArtGate
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Import - LidarrCompanion</PageTitle>

@if (!string.IsNullOrWhiteSpace(_revealedFolderPath))
{
    <div class="folder-popup">
        <button class="notice-dismiss" @onclick="DismissRevealedFolder">✕</button>
        @if (!string.IsNullOrWhiteSpace(_revealedFilePath))
        {
            <div class="folder-popup-row">
                <span class="folder-popup-label">File</span>
                <span class="folder-popup-path">@_revealedFilePath</span>
                <button @onclick="() => CopyPath(_revealedFilePath)">Copy</button>
            </div>
        }
        <div class="folder-popup-row">
            <span class="folder-popup-label">Folder</span>
            <span class="folder-popup-path">@_revealedFolderPath</span>
            <button @onclick="() => CopyPath(_revealedFolderPath)">Copy</button>
        </div>
        @if (_revealedFolderShareLink is not null)
        {
            <a href="@_revealedFolderShareLink">Open (share link)</a>
        }
    </div>
}

<div class="triage-page @(Triage.IsBusy ? "busy" : "")">
    <section class="triage-queue">
        <div class="triage-queue-header">
            <h2>Lidarr Queue Records</h2>
        </div>
        <div class="triage-queue-body">
            <div class="table-scroll">
                <table class="triage-table">
                    <thead><tr><th>Title</th><th>File Path</th><th>Download ID</th><th>Matched Artist</th></tr></thead>
                    <tbody>
                        @foreach (var record in Triage.QueueRecords)
                        {
                            <tr class="@(record == Triage.SelectedQueueRecord ? "row-selected" : "")"
                                style="background-color:@ActionColorHelper.GetQueueMatchColor(record.Match);color:@ActionColorHelper.GetQueueMatchForeground(record.Match)"
                                @onclick="() => SelectQueueRecord(record)">
                                <td>@record.Title</td>
                                <td>@record.OutputPath</td>
                                <td>@record.DownloadId</td>
                                <td>
                                    @record.MatchedArtist
                                    @if (Triage.IsArtistPending(record.MatchedArtist))
                                    {
                                        <span class="pending-indicator" title="@Triage.PendingArtistMessage(record.MatchedArtist)">⏳</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="triage-queue-actions">
                <button class="action-btn" @onclick="Refresh" title="Reload the queue and artists from Lidarr, and auto-match releases to artists (Alt+1)">Refresh</button>
                <button class="action-btn" @onclick="OpenManualMatch" title="Alt+A">Match Artist</button>
            </div>
        </div>
    </section>

    <section class="triage-columns">
        <div class="triage-col triage-files">
            <div class="triage-col-header">
                <h2>Unimported Release Files</h2>
                <button class="icon-btn" @onclick="PlayTrack" @oncontextmenu="AdvanceTrack" @oncontextmenu:preventDefault="true" title="Play/Stop (Alt+P), right-click +30s">
                    @(Playback.IsPlaying ? "⏹" : "▶")
                </button>
                <button class="icon-btn" @onclick="OpenReleaseFolder" title="Open Folder">📁</button>
            </div>
            <div class="table-scroll">
                <table class="triage-table">
                    <thead><tr><th></th><th>Name</th><th>Path</th></tr></thead>
                    <tbody>
                        @if (Triage.IsLoadingSelection && Triage.ManualImportFiles.Count == 0)
                        {
                            <tr><td colspan="3" class="pending-note">⏳ Loading files...</td></tr>
                        }
                        @{ var releaseHasImport = ReleaseHasImportAction(); }
                        @foreach (var file in Triage.ManualImportFiles)
                        {
                            var willUnlink = releaseHasImport && !file.ProposedActionType.HasValue;
                            <tr class="@(file == Triage.SelectedFile ? "row-selected" : "") @(willUnlink ? "will-unlink" : "")"
                                title="@(willUnlink ? "No action yet - will be unlinked when you process (Lidarr deletes files left behind in the folder)." : null)"
                                style="@FileRowStyle(file)">
                                <td>
                                    <input type="checkbox" checked="@Triage.CheckedFileIds.Contains(file.Id)" @onchange="e => ToggleFileChecked(file, (bool)(e.Value ?? false))" />
                                </td>
                                <td @onclick="e => SelectFile(file, e)">@file.Name</td>
                                <td @onclick="e => SelectFile(file, e)">@file.Path</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="triage-col triage-tracks">
            <h2>Artist Release Files</h2>
            <div class="table-scroll">
                <table class="triage-table">
                    <thead><tr><th>Type</th><th>Release</th><th>Track</th><th>Exists?</th><th>Score</th></tr></thead>
                    <tbody>
                        @if (Triage.PendingArtistMessage(Triage.SelectedQueueRecord?.MatchedArtist) is { } pendingMessage)
                        {
                            <tr><td colspan="5" class="pending-note">⏳ @pendingMessage You can carry on with another release meanwhile.</td></tr>
                        }
                        @if (Triage.IsLoadingSelection && Triage.ArtistReleaseTracks.Count == 0 && Triage.PendingArtistMessage(Triage.SelectedQueueRecord?.MatchedArtist) is null)
                        {
                            <tr><td colspan="5" class="pending-note">⏳ Loading releases...</td></tr>
                        }
                        @foreach (var track in Triage.ArtistReleaseTracks)
                        {
                            <tr class="@(track == Triage.SelectedTrack ? "row-selected" : "") @(track.IsAssigned ? "row-disabled" : "")"
                                style="background-color:@TrackRowColor(track)"
                                @onclick="() => SelectTrack(track)">
                                <td>@track.AlbumType</td>
                                <td>@track.Release</td>
                                <td>@track.Track</td>
                                <td><input type="checkbox" checked="@track.HasFile" disabled /></td>
                                <td class="numeric">@track.Score.ToString("F1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="triage-col triage-controls">
            <div class="sort-buttons">
                <span class="sort-filter-icon" title="Sort / filter">🔽</span>
                <button class="sort-btn @(_sortMode == "by Release" ? "active" : "")" title="Sort by Release" @onclick='() => SetSort("by Release")'>💿</button>
                <button class="sort-btn @(_sortMode == "by Track Num" ? "active" : "")" title="Sort by Track Num" @onclick='() => SetSort("by Track Num")'>🔢</button>
                <button class="sort-btn @(_sortMode == "by Track Name" ? "active" : "")" title="Sort by Track Name" @onclick='() => SetSort("by Track Name")'>🔤</button>
                <button class="sort-btn @(_sortMode == "by Best" ? "active" : "")" title="Sort by Best Match" @onclick='() => SetSort("by Best")'>⭐</button>
            </div>

            <button class="action-btn" @onclick="MarkMatch" title="M (or Alt+M)">Mark Match (M)</button>
            <button class="action-btn" @onclick="() => ProposeAndAdvance(ProposalActionType.Unlink)" title="U (or Alt+U)">Unlink File (U)</button>
            <button class="action-btn" @onclick="() => ProposeAndAdvance(ProposalActionType.Delete)" title="X (or Alt+X)">Delete File (X)</button>

            @foreach (var dest in Triage.Destinations)
            {
                <div class="destination-buttons">
                    <button class="destination-move" title="@dest.DestinationPath" @onclick="() => MoveToDestination(dest)">Move: @dest.Name</button>
                    <button class="destination-folder" title="@($"Open folder: {dest.DestinationPath}")" @onclick="() => OpenDestinationFolder(dest)">📁</button>
                </div>
            }
        </div>
    </section>

    <section class="triage-proposed">
        <h2>Actions to Take</h2>
        <div class="triage-proposed-body">
            <div class="table-scroll">
                <table class="triage-table">
                    <thead><tr><th>Type</th><th>FileName</th><th>OriginalRelease</th><th>MatchedArtist</th><th>MatchedTrack</th><th>MatchedRelease</th></tr></thead>
                    <tbody>
                        @foreach (var pa in Triage.ProposedActions)
                        {
                            <tr class="@(pa == Triage.SelectedProposedAction ? "row-selected" : "")"
                                style="@(pa.IsImportFailed ? "background-color:#f44336;color:#fff" : $"background-color:{ActionColorHelper.GetActionBackground(pa.Action, pa.DestinationName)};color:{ActionColorHelper.GetActionForeground(pa.Action, pa.DestinationName)}")"
                                @onclick="() => Triage.SelectedProposedAction = pa">
                                <td>@pa.Action</td>
                                <td>@pa.OriginalFileName</td>
                                <td>@pa.OriginalRelease</td>
                                <td>@pa.MatchedArtist</td>
                                <td>@pa.MatchedTrack</td>
                                <td>@pa.MatchedRelease</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="triage-proposed-actions">
                <button class="action-btn" @onclick="Unselect">Unselect</button>
                <button class="action-btn" @onclick="ClearProposed">Clear</button>
                <button class="action-btn btn-process" @onclick="ProcessImport">Process Actions</button>
            </div>
        </div>
    </section>
</div>

@if (_showManualMatch)
{
    <ManualMatchDialog Candidates="Triage.Artists" ReleasePath="@_manualMatchSeed" OnClosed="OnManualMatchClosed" />
}

@code {
    private bool _showManualMatch;
    private string _manualMatchSeed = string.Empty;
    private string _sortMode = "by Best";
    private string? _revealedFilePath;
    private string? _revealedFolderPath;
    private string? _revealedFolderShareLink;

    private IJSObjectReference? _shortcutsModule;
    private DotNetObjectReference<Import>? _selfRef;

    // Without this, Triage.IsBusy (checked below to gate the whole page's pointer-events via the
    // "busy" class) is only ever re-evaluated when THIS page's own event handlers call
    // StateHasChanged - never when a busy operation started/finished elsewhere (a fire-and-forget
    // refresh already in flight when this page was navigated to, another circuit, a background
    // job). If that operation finishes after this component's last render, the page is left
    // showing stale "busy" styling with pointer-events:none forever - and since that blocks every
    // click, nothing on the page can trigger the re-render that would clear it. StatusBar.razor
    // already does this correctly for its own status text; this page's busy styling needed the
    // same live subscription and didn't have it.
    protected override void OnInitialized()
    {
        Status.Changed += OnStatusChanged;
        Triage.ArtistJobsChanged += OnArtistJobsChanged;
        Triage.ArtistReleasesReady += OnArtistReleasesReady;

        // Landing here with nothing loaded, data from before this sign-in, or data older than
        // RefreshPolicy.DefaultMaxAge: fetch it (and auto-match) rather than showing an empty or
        // stale queue. Completion re-renders via Status.Changed above.
        if (Triage.NeedsRefresh)
            _ = Triage.RefreshAsync();
        else if (Triage.SelectedQueueRecord?.MatchedArtist is { Length: > 0 } matched
            && Triage.ArtistReleaseTracks.Count == 0 && !Triage.IsArtistPending(matched))
            _ = ReloadSelectedArtistReleasesAsync(matched);
    }

    // A background manual-match job can finish while no Import page is mounted (the user was on
    // another page, or reloaded), in which case nothing was listening for it - the tracks are
    // cached but this component's view of them is empty until something asks again.
    private async Task ReloadSelectedArtistReleasesAsync(string artistName)
    {
        await Triage.RefreshSelectedArtistReleasesAsync(artistName);
        await InvokeAsync(StateHasChanged);
    }

    private void OnStatusChanged() => InvokeAsync(StateHasChanged);
    private void OnArtistJobsChanged() => InvokeAsync(StateHasChanged);

    // A background manual-match job finished (see TriageService.ApplyManualMatch). Runs on this
    // circuit's sync context so the tracks collection isn't touched while a render is reading it.
    private void OnArtistReleasesReady(string artistName) => InvokeAsync(async () =>
    {
        await Triage.RefreshSelectedArtistReleasesAsync(artistName);
        StateHasChanged();
    });

    // Set whenever selection moves to a different file, so that once the re-sorted tracks list has
    // rendered it's scrolled back to the top (and the newly selected file kept in view) - otherwise
    // the best matches for the new file sit above wherever the list happened to be scrolled.
    private bool _scrollAfterRender;
    private LidarrManualImportFile? _anchorFile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _shortcutsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboardShortcuts.js");
            await _shortcutsModule.InvokeVoidAsync("register", _selfRef);
        }

        if (_scrollAfterRender && _shortcutsModule is not null)
        {
            _scrollAfterRender = false;
            await _shortcutsModule.InvokeVoidAsync("scrollToTop", ".triage-tracks .table-scroll");
            await _shortcutsModule.InvokeVoidAsync("scrollSelectedIntoView", ".triage-files .table-scroll", "tr.row-selected");
        }
    }

    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        // The page is inert while busy (pointer-events:none) and while the match dialog is open;
        // keyboard input shouldn't be able to act on it either.
        if (Triage.IsBusy || _showManualMatch) return;

        switch (key)
        {
            case "1": await Refresh(); break;
            case "a": OpenManualMatch(); break;
            case "m": await MarkMatch(); break;
            case "x": await ProposeAndAdvance(ProposalActionType.Delete); break;
            case "u": await ProposeAndAdvance(ProposalActionType.Unlink); break;
            case "p": await PlayTrack(); break;
        }

        StateHasChanged();
    }

    private async Task Refresh() { await Triage.RefreshAsync(); StateHasChanged(); }

    private async Task SelectQueueRecord(LidarrQueueRecord record)
    {
        await Triage.OnQueueRecordSelectedAsync(record);
        StateHasChanged();
    }

    // Plain click: select the file (drives the tracks list's "best match" sort). Shift-click:
    // check every file from the last-clicked one to this one. Ctrl/Cmd-click: toggle this file's
    // check without disturbing the others. Checked files are what Delete/Unlink/Move act on.
    private void SelectFile(LidarrManualImportFile file, MouseEventArgs e)
    {
        if (e.ShiftKey)
        {
            var range = FileSelection.RangeBetween(Triage.ManualImportFiles, _anchorFile ?? Triage.SelectedFile, file);
            Triage.CheckedFileIds.Clear();
            foreach (var f in range)
                Triage.CheckedFileIds.Add(f.Id);
        }
        else
        {
            if (e.CtrlKey || e.MetaKey)
                ToggleFileChecked(file, !Triage.CheckedFileIds.Contains(file.Id));
            _anchorFile = file;
        }

        Triage.SelectedFile = file;
        Triage.ApplySort(_sortMode);
        _scrollAfterRender = true;
    }

    private void ToggleFileChecked(LidarrManualImportFile file, bool isChecked)
    {
        if (isChecked) Triage.CheckedFileIds.Add(file.Id);
        else Triage.CheckedFileIds.Remove(file.Id);
    }

    private void SelectTrack(LidarrArtistReleaseTrack track) => Triage.SelectedTrack = track;

    private void SetSort(string mode)
    {
        _sortMode = mode;
        Triage.ApplySort(_sortMode);
    }

    private async Task MarkMatch()
    {
        var acted = Triage.SelectedFile;
        var result = Triage.MarkMatch();
        if (result == MarkMatchResult.NeedsOverwriteConfirmation)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "Selected track already has a file. Assigning will overwrite it. Continue?");
            if (confirmed) result = Triage.MarkMatch(overwriteConfirmed: true);
        }

        if (result == MarkMatchResult.Success)
            await Advance(acted);

        StateHasChanged();
    }

    private async Task ProposeAndAdvance(ProposalActionType kind)
    {
        var acted = Triage.CreateProposal(kind);
        if (acted.Count > 0)
            await Advance(acted[^1]);
        StateHasChanged();
    }

    private async Task MoveToDestination(ImportDestination dest)
    {
        var acted = Triage.MoveToDestination(dest);
        if (acted.Count > 0)
            await Advance(acted[^1]);
        StateHasChanged();
    }

    private async Task Advance(LidarrManualImportFile? acted)
    {
        if (await Triage.AdvanceAfterActionAsync(acted))
            _scrollAfterRender = true;
        _anchorFile = Triage.SelectedFile;
    }

    private void Unselect()
    {
        if (Triage.SelectedProposedAction is { } pa)
        {
            Triage.Unselect(pa);
        }
        else
        {
            Status.ShowError("Select a proposed action to unselect.");
        }
        StateHasChanged();
    }

    private void ClearProposed()
    {
        Triage.ClearProposed();
        StateHasChanged();
    }

    private async Task ProcessImport()
    {
        // Result is reported via the status bar (see TriageService.PostImportSummary), not here.
        await Triage.ProcessImportAsync();

        // If cover art is now blocking the import, go straight there instead of leaving the user
        // to notice and click a status-bar link - the status bar still carries a link too, as a
        // way back if they navigate off before finishing.
        if (CoverArtGate.HasPending)
        {
            Nav.NavigateTo("/cover-art");
            return;
        }

        StateHasChanged();
    }

    // Releases with an Import action get every action-less file auto-unlinked at processing time
    // (TriageService.AddImplicitUnlinksAsync); this is just the on-screen hint for that.
    private bool ReleaseHasImportAction() =>
        Triage.SelectedQueueRecord is { } record
        && Triage.ProposedActions.Any(p => p.Action == ProposalActionType.Import && !p.IsImplicitUnlink
            && ImplicitUnlink.IsSameRelease(record.DownloadId, record.Title, new ImplicitUnlink.ReleaseKey(p.DownloadId ?? string.Empty, p.OriginalRelease ?? string.Empty)));

    private string? GetDestinationName(LidarrManualImportFile file)
    {
        var pa = Triage.ProposedActions.FirstOrDefault(p => p.FileId == file.Id);
        return pa?.DestinationName;
    }

    // file.ProposedActionType is nullable - null must stay transparent/inherit, not fall through
    // to ProposalActionType's default enum value (Import = 0, which would wrongly paint every
    // unassigned file green).
    private string FileRowStyle(LidarrManualImportFile file)
    {
        if (!file.ProposedActionType.HasValue) return "background-color:transparent;color:inherit";

        var destName = GetDestinationName(file);
        var bg = ActionColorHelper.GetActionBackground(file.ProposedActionType.Value, destName);
        var fg = ActionColorHelper.GetActionForeground(file.ProposedActionType.Value, destName);
        return $"background-color:{bg};color:{fg}";
    }

    private static string TrackRowColor(LidarrArtistReleaseTrack track)
    {
        if (track.IsAssigned) return ActionColorHelper.GetThemedColor("trackassigned");
        if (track.HasFile) return ActionColorHelper.GetThemedColor("trackhasfile");
        if (track.ReleaseHasOtherAssigned) return ActionColorHelper.GetThemedColor("releasehasassigned");
        return "transparent";
    }

    private async Task PlayTrack()
    {
        if (Playback.IsPlaying)
        {
            Playback.Stop();
            return;
        }

        if (Triage.SelectedFile is not { } file)
        {
            Status.ShowError("Select a file from 'Unimported Release Files' first.");
            StateHasChanged();
            return;
        }

        Playback.Play(new NowPlayingTrack($"/audio/stream/{file.Id}", file.Name, Triage.SelectedQueueRecord?.MatchedArtist, null));
        await Task.CompletedTask;
    }

    private void AdvanceTrack() => Playback.AdvanceBy(TimeSpan.FromSeconds(30));

    private void OpenReleaseFolder()
    {
        string? rawPath = Triage.SelectedFile?.Path ?? Triage.SelectedQueueRecord?.OutputPath;
        if (string.IsNullOrWhiteSpace(rawPath))
        {
            Status.ShowError("Select a file or release first.");
            StateHasChanged();
            return;
        }

        RevealFolder(rawPath);
    }

    private void OpenDestinationFolder(ImportDestination dest)
    {
        if (string.IsNullOrWhiteSpace(dest.DestinationPath))
        {
            Status.ShowError($"Destination folder '{dest.Name}' is not configured.");
            StateHasChanged();
            return;
        }
        RevealFolder(dest.DestinationPath, alreadyResolved: true);
    }

    private void RevealFolder(string rawPath, bool alreadyResolved = false)
    {
        var resolved = alreadyResolved ? rawPath : FileOperationsHelper.ResolveMappedPathAnyKnown(rawPath, true);
        var isFile = File.Exists(resolved);
        var folder = isFile ? (Path.GetDirectoryName(resolved) ?? resolved) : resolved;

        _revealedFilePath = isFile ? resolved : null;
        _revealedFolderPath = folder;
        _revealedFolderShareLink = BuildShareLink(folder);
        StateHasChanged();
    }

    private static string? BuildShareLink(string resolvedLocalPath)
    {
        var shareBase = AppSettings.GetValue(SettingKey.NetworkShareBase);
        if (string.IsNullOrWhiteSpace(shareBase)) return null;

        // The resolved path could have come from either local mapping - try both roots.
        foreach (var key in new[] { SettingKey.ImportPathCompanion, SettingKey.DownloadPathCompanion })
        {
            var localRoot = AppSettings.GetValue(key);
            if (string.IsNullOrWhiteSpace(localRoot)) continue;
            if (!resolvedLocalPath.StartsWith(localRoot, StringComparison.OrdinalIgnoreCase)) continue;

            var relative = resolvedLocalPath[localRoot.Length..].TrimStart('/', '\\').Replace('\\', '/');
            return shareBase.TrimEnd('/') + "/" + relative;
        }

        return null;
    }

    private async Task CopyPath(string? path)
    {
        if (!string.IsNullOrWhiteSpace(path))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", path);
    }

    private void DismissRevealedFolder()
    {
        _revealedFilePath = null;
        _revealedFolderPath = null;
        _revealedFolderShareLink = null;
    }

    private void OpenManualMatch()
    {
        if (Triage.SelectedQueueRecord is not { } record)
        {
            Status.ShowError("Select a release from the list first.");
            StateHasChanged();
            return;
        }

        var importPath = AppSettings.GetValue(SettingKey.ImportPathLidarr);
        var isSingleFile = FileAndAudioService.IsSingleFileRelease(record.OutputPath, importPath);
        _manualMatchSeed = isSingleFile
            ? Path.GetFileNameWithoutExtension(record.OutputPath) ?? string.Empty
            : FileAndAudioService.GetLowestFolderName(record.OutputPath) ?? string.Empty;

        _showManualMatch = true;
    }

    // Closes immediately: TriageService.ApplyManualMatch marks the release matched and does the
    // slow part (adding the artist to Lidarr, waiting for its releases) in the background, so the
    // user can go straight on to the next release.
    private void OnManualMatchClosed(LidarrArtist? selected)
    {
        _showManualMatch = false;
        if (selected is not null && Triage.SelectedQueueRecord is { } record)
            Triage.ApplyManualMatch(record, selected);
    }

    public async ValueTask DisposeAsync()
    {
        Status.Changed -= OnStatusChanged;
        Triage.ArtistJobsChanged -= OnArtistJobsChanged;
        Triage.ArtistReleasesReady -= OnArtistReleasesReady;
        _selfRef?.Dispose();
        if (_shortcutsModule is not null)
        {
            try
            {
                await _shortcutsModule.InvokeVoidAsync("unregister");
                await _shortcutsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
    }
}
