@implements IAsyncDisposable
@inject IPlaybackService Playback
@inject IJSRuntime JS

<div class="player-bar">
    @if (Playback.Current is { } track)
    {
        <span class="player-bar-cover">
            @if (!string.IsNullOrWhiteSpace(track.CoverArtUrl))
            {
                <img src="@track.CoverArtUrl" alt="" />
            }
        </span>
        <span class="player-bar-info">
            <span class="player-bar-title">@track.Title</span>
            @if (!string.IsNullOrWhiteSpace(track.Artist))
            {
                <span class="player-bar-artist">@track.Artist</span>
            }
        </span>

        <div class="player-bar-controls">
            <button class="player-bar-btn" @onclick="TogglePlayPause" title="Play/Pause">@(Playback.IsPlaying ? "⏸" : "▶")</button>
            <button class="player-bar-btn" @onclick="() => Playback.Stop()" title="Stop">⏹</button>
        </div>

        <span class="player-bar-time">@FormatTime(Playback.Position)</span>
        <input type="range" class="player-bar-seek" min="0" max="100" step="0.1" @ref="_seekBarRef" />
        <span class="player-bar-time">@FormatTime(Playback.Duration)</span>

        <div class="player-bar-volume">
            <span title="Volume">🔊</span>
            <input type="range" min="0" max="100" value="@((int)(Playback.Volume * 100))" @oninput="OnVolumeInput" />
        </div>
    }
    else
    {
        <span class="player-bar-empty">Nothing playing</span>
    }
</div>

<audio @ref="_audioRef" style="display:none"></audio>

@code {
    private ElementReference _audioRef;
    private ElementReference _seekBarRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlayerBar>? _selfRef;
    private NowPlayingTrack? _lastStarted;
    private bool _seekBarRegistered;

    protected override void OnInitialized()
    {
        Playback.StateChanged += OnStateChanged;
        Playback.RelativeSeekRequested += OnRelativeSeekRequested;
        Playback.PercentSeekRequested += OnPercentSeekRequested;
        Playback.VolumeChangeRequested += OnVolumeChangeRequested;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnRelativeSeekRequested(TimeSpan amount) => InvokeAsync(async () =>
    {
        if (_module is not null) await _module.InvokeVoidAsync("advanceBy", _audioRef, amount.TotalSeconds);
    });

    private void OnPercentSeekRequested(double percent) => InvokeAsync(async () =>
    {
        if (_module is not null) await _module.InvokeVoidAsync("seekToPercent", _audioRef, percent);
    });

    private void OnVolumeChangeRequested(double volume) => InvokeAsync(async () =>
    {
        if (_module is not null) await _module.InvokeVoidAsync("setVolume", _audioRef, volume);
    });

    private async Task TogglePlayPause()
    {
        if (_module is not null) await _module.InvokeVoidAsync("togglePlayPause", _audioRef);
    }

    private void OnVolumeInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var vol))
            Playback.SetVolume(vol / 100.0);
    }

    private static string FormatTime(TimeSpan t) => t.ToString(t.TotalHours >= 1 ? @"h\:mm\:ss" : @"m\:ss");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/audioPlayer.js");
        _selfRef ??= DotNetObjectReference.Create(this);

        if (firstRender)
        {
            await _module.InvokeVoidAsync("setVolume", _audioRef, Playback.Volume);
        }

        // The seek bar element only exists in the DOM once a track is playing (it's inside the
        // @if block), so register it the first time it actually shows up rather than only on
        // firstRender.
        if (!_seekBarRegistered && Playback.Current is not null)
        {
            _seekBarRegistered = true;
            await _module.InvokeVoidAsync("registerSeekBar", _audioRef, _seekBarRef);
        }

        // Only (re)start playback when the track actually changed - OnAfterRenderAsync fires on
        // every re-render (e.g. a Playing/Paused status text update), not just track changes.
        if (Playback.Current is { } track && !ReferenceEquals(track, _lastStarted))
        {
            _lastStarted = track;
            await _module.InvokeVoidAsync("play", _audioRef, track.StreamUrl, _selfRef, track.StartPercent);
        }
        else if (Playback.Current is null && _lastStarted is not null)
        {
            _lastStarted = null;
            _seekBarRegistered = false;
            await _module.InvokeVoidAsync("stop", _audioRef);
        }
    }

    [JSInvokable]
    public void OnAudioStateChanged(bool isPlaying) => Playback.SetPlaying(isPlaying);

    [JSInvokable]
    public void OnProgress(double positionSeconds, double durationSeconds)
    {
        Playback.SetProgress(TimeSpan.FromSeconds(positionSeconds), TimeSpan.FromSeconds(durationSeconds));
    }

    public async ValueTask DisposeAsync()
    {
        Playback.StateChanged -= OnStateChanged;
        Playback.RelativeSeekRequested -= OnRelativeSeekRequested;
        Playback.PercentSeekRequested -= OnPercentSeekRequested;
        Playback.VolumeChangeRequested -= OnVolumeChangeRequested;
        _selfRef?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
    }
}
